# Copy this file to .env and fill in the blanks. Restart the server after changes.

# Where the site listens. Use an uncommon port locally.
PORT=47231
HOST=0.0.0.0

# Public address used in emails, QR codes, and proof links.
# Each Render service sets this to its own https URL, with no slash at the end.
# The QR then points at that service's /e/<event>.
PUBLIC_BASE_URL=http://127.0.0.1:47231

# event_day: / opens the LED screen. after_event: / opens the phone form.
# An event in config can set its own "mode" and that wins for that event only.
SITE_MODE=after_event

# Password for the first admin account. Use a long password on a public server.
ADMIN_PASSWORD=change-this-password
# Email for that bootstrap admin. Created only when no admin account exists yet.
ADMIN_EMAIL=admin@renofiesta.sg

# Folder for the CSV fallback, proof files, and the email outbox.
DATA_DIR=./data

# Optional. If blank, a random secret is saved in data/file-secret.txt.
FILE_LINK_SECRET=

# Set to 1 only if the server sits behind a proxy that sets X-Forwarded-For
# (Render, Railway, Cloudflare). Leave 0 on a laptop.
TRUST_PROXY=0

# --- Email (Resend) ---------------------------------------------------------
# Leave RESEND_API_KEY blank to run without email. Signups and spins still
# work. Messages are saved to data/outbox.json and shown on the admin page.
# The homeowner is told to screenshot the code.
RESEND_API_KEY=
EMAIL_FROM=IDLah Sure-Win <spin@example.com>

# --- Google Sheets ----------------------------------------------------------
# Leave all three blank to store entries in data/entries.csv instead.
# See the README for click-by-click steps. The private key is one line with \n.
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Proof files on Cloudflare R2 (optional) --------------------------------
# Leave blank to save proof files in data/uploads on this computer.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Must be 0 or blank on any public server. 1 lets tests on this machine
# force a prize. Never turn this on in production.
ALLOW_FORCE_PRIZE=0

# LED registration QR, used when staff have not saved a size in the store
# (and after a restart if data/kiosk-qr.json was wiped). A saved admin
# value overrides these. Size: 16-70, 16%, or 280px. Position: top-center,
# top-left, top-right, bottom-center, bottom-left, bottom-right.
# KIOSK_QR_SIZE=16%
# KIOSK_QR_POSITION=top-center
